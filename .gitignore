/target
# Exact-commit validation records are local evidence artifacts.  A record is
# valid only for the clean commit it names, so it is never source-controlled.
/validation/results/
/validation/**/__pycache__/
/fuzz/target/
/fuzz/artifacts/
# `apps/signalman-desktop` roots its own workspace (it is `exclude`d from this
# one), so its build directory is a second `target/` the root-anchored rule
# above does not cover.
/apps/signalman-desktop/target

# Cargo.lock IS tracked here. This workspace is not a bare library: it builds
# firmware images that get flashed to real hardware, and tulle tracked its own
# lockfile for exactly that reason before the 2026-07-23 radio merge. Losing it
# in the merge is how a fresh resolution picked `fixed` 1.31.0 (rustc >= 1.93)
# and broke the t114 build on an older default toolchain.

# The oracle's Python venv. Recreate with oracle/requirements.txt (currently rns==1.5.2);
# see oracle/README.md. The fixtures it produces ARE committed, so tests need no Python.
oracle/.venv/
# Python's bytecode cache for the local Reticulum oracle drivers.
crates/retinue/oracle/__pycache__/

# Weave's local merge state is machine-local generated data.
.weave/

# Hardware receipts can contain MAC addresses and serial-port observations.
design_docs/2026-07-28_v4_on_device_ui_acceptance.md

# Coordinated-disclosure records. An upstream security finding's board, source
# path, reproduction, and impact stay out of a public repository until the
# maintainer has had a report and a disclosure state is recorded. See
# design_docs/2026-08-10_prns_donor_ledger.md section 5.
design_docs/private/

# Station identities. Postilion mints these beside the working directory, so running
# signalman from the repo root drops one here. They are private keys: never committed.
*.id
